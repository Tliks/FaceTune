#list-item-container {
    align-items: center;
    position: relative;
}

#metadata-gutter {
    flex: 0 0 9px;
    height: 18px;
    flex-direction: row;
    align-items: center;
}

#changed-marker {
    width: 3px;
    height: 18px;
    margin-right: 4px;
    opacity: 0;
    background-color: var(--unity-colors-link-text);
}

#changed-marker.changed-marker--visible {
    opacity: 0.7;
}

#metadata-gutter:hover #changed-marker.changed-marker--visible {
    opacity: 1;
}

#facial-rail {
    width: 2px;
    height: 14px;
    background-color: var(--unity-colors-default-text);
}

#validation-warning {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

#name {
    flex: 1 1 100px;
}

#slider-float-field {
    flex: 2 1 100px;
    padding: 0px;
}

#curve-field {
    flex: 2 1 100px;
    padding: 0px;
}

#curve-toggle,
#toggle-button,
#action {
    flex: 0 0 30px;
}

.flash-overlay {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    opacity: 0;
    background-color: rgba(255, 220, 120, 0.35);
    transition-property: opacity;
    transition-duration: 500ms;
    transition-timing-function: ease-out;
}
